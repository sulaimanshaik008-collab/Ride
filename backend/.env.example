# ==========================================
# Backend Production Environment Variables
# ==========================================

# Server Configuration
PORT=8080

# Supabase / PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://<your-supabase-db-host>:5432/postgres?sslmode=require
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=<your-db-password>
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Supabase REST API & Security
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_API_KEY=<your-supabase-publishable-key>
JWT_SECRET=<your-base64-256bit-jwt-secret>

# Twilio SMS Gateway Configuration (Optional - set SMS_ENABLED=true for live SMS)
SMS_ENABLED=false
SMS_PROVIDER=TWILIO
SMS_ACCOUNT_ID=<your-twilio-account-sid>
SMS_AUTH_TOKEN=<your-twilio-auth-token>
SMS_FROM_NUMBER=<your-twilio-phone-number>

# Production CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.supabase.co,https://*.vercel.app
