# ==========================================
# Frontend Production Environment Variables
# ==========================================

# Google Maps API Key (Must have Places API, Maps JavaScript API, Geocoding API, Routes API enabled)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API Base URL (leave blank for local Vite proxy, or specify absolute URL in production)
VITE_API_BASE_URL=
